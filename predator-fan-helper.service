[Unit]
Description=Predator Fan Manager privileged helper
After=local-fs.target systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/local/lib/predator-fan-manager/predator-fan-helper --uid=@UID@
Restart=on-failure
RestartSec=2
RuntimeDirectory=predator-fan-manager
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
